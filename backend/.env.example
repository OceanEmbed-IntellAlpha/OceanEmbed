# Backend API Configuration
API_PORT=8000
ENVIRONMENT=development

# Copernicus Marine Service Credentials
# Register at: https://data.marine.copernicus.eu/register
COPERNICUSMARINE_SERVICE_USERNAME=your_cmems_username
COPERNICUSMARINE_SERVICE_PASSWORD=your_cmems_password

# NASA Earthdata Credentials (OSCAR currents + CCMP winds)
# Register at: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# ── Data Paths ─────────────────────────────────────────────
# Estimated disk space for full 14-year production run:
#   Raw downloads:  ~160–200 GB
#   Processed Zarr: ~80–120 GB
#   Total needed:   ~250–320 GB free space
RAW_DATA_DIR=./data/raw
INTERIM_DATA_DIR=./data/interim
PROCESSED_DATA_DIR=./data/processed

# ── Dataset Date Configuration ─────────────────────────────
# Master download window (all 6 datasets must share this range)
DATA_START_DATE=2010-01-01
DATA_END_DATE=2023-12-31
# Split boundaries (MUST match pipeline_config.yaml → splits)
TRAIN_START=2010-01-01
TRAIN_END=2019-12-31
VAL_START=2020-01-01
VAL_END=2021-12-31
TEST_START=2022-01-01
TEST_END=2023-12-31

# ── SMAP SSS Gap Handling ──────────────────────────────────
# SMAP satellite launched April 2015. Before this date the
# pipeline falls back to SMOS-only SSS.
SMAP_START_DATE=2015-04-01
